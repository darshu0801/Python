import tkinter as tk
from tkinter import filedialog, messagebox
import pandas as pd
import os
import shutil
from openpyxl import load_workbook
from openpyxl.styles import PatternFill
import matplotlib.pyplot as plt


# =========================================================
# COPY CELL STYLE
# =========================================================
def copy_cell_style(src_cell, dst_cell):
    if src_cell.has_style:
        dst_cell._style = src_cell._style

    if src_cell.number_format:
        dst_cell.number_format = src_cell.number_format

    if src_cell.font:
        dst_cell.font = src_cell.font.copy()

    if src_cell.fill:
        dst_cell.fill = src_cell.fill.copy()

    if src_cell.border:
        dst_cell.border = src_cell.border.copy()

    if src_cell.alignment:
        dst_cell.alignment = src_cell.alignment.copy()

    if src_cell.protection:
        dst_cell.protection = src_cell.protection.copy()


# =========================================================
# GENERATE COMPARISON EXCEL
# =========================================================
def generate_comparison_excel(source_file, diff_df, output_file):

    # Copy original excel completely
    shutil.copy(source_file, output_file)

    wb = load_workbook(output_file)
    ws = wb.active

    original_max_row = ws.max_row
    original_max_col = ws.max_column

    start_row = original_max_row + 4

    # =====================================================
    # TITLE
    # =====================================================
    title_cell = ws.cell(row=start_row, column=1)
    title_cell.value = "Difference Table (File2 - File1)"

    # Copy style from A1
    copy_cell_style(ws["A1"], title_cell)

    # =====================================================
    # COPY HEADER FORMAT
    # =====================================================
    header_row = 1

    for col_idx in range(1, original_max_col + 1):

        src_cell = ws.cell(row=header_row, column=col_idx)
        dst_cell = ws.cell(row=start_row + 1, column=col_idx)

        dst_cell.value = src_cell.value

        copy_cell_style(src_cell, dst_cell)

        # Copy column width
        col_letter = src_cell.column_letter
        ws.column_dimensions[col_letter].width = \
            ws.column_dimensions[col_letter].width

    # =====================================================
    # COLOR DEFINITIONS
    # =====================================================
    green_fill = PatternFill(
        start_color="C6EFCE",
        end_color="C6EFCE",
        fill_type="solid"
    )

    red_fill = PatternFill(
        start_color="FFC7CE",
        end_color="FFC7CE",
        fill_type="solid"
    )

    perf_keywords = [
        "read",
        "write",
        "mbps",
        "iops",
        "throughput",
        "bw",
        "bandwidth"
    ]

    power_keywords = [
        "power",
        "watt",
        "mw",
        "current"
    ]

    # =====================================================
    # WRITE DATA WITH FORMATTING
    # =====================================================
    for i in range(len(diff_df)):

        src_excel_row = i + 2
        dst_excel_row = start_row + 2 + i

        for j in range(len(diff_df.columns)):

            col_name = diff_df.columns[j]

            src_cell = ws.cell(
                row=src_excel_row,
                column=j + 1
            )

            dst_cell = ws.cell(
                row=dst_excel_row,
                column=j + 1
            )

            value = diff_df.iloc[i, j]

            dst_cell.value = value

            # Copy original formatting
            copy_cell_style(src_cell, dst_cell)

            # =============================================
            # COLOR CODING
            # =============================================
            if isinstance(value, (int, float)):

                col_lower = str(col_name).lower()

                # PERFORMANCE METRICS
                if any(k in col_lower for k in perf_keywords):

                    if value > 0:
                        dst_cell.fill = green_fill

                    elif value < 0:
                        dst_cell.fill = red_fill

                # POWER METRICS
                elif any(k in col_lower for k in power_keywords):

                    if value < 0:
                        dst_cell.fill = green_fill

                    elif value > 0:
                        dst_cell.fill = red_fill

    wb.save(output_file)


# =========================================================
# MAIN COMPARISON
# =========================================================
def compare_excels(file1, file2, log):

    try:

        log("Loading excel files...")

        df1 = pd.read_excel(file1)
        df2 = pd.read_excel(file2)

        # =================================================
        # VALIDATION
        # =================================================
        if df1.shape != df2.shape:
            raise Exception(
                "Excel shapes are different. "
                "Row-wise comparison not possible."
            )

        # =================================================
        # DIFFERENCE TABLE
        # =================================================
        log("Generating difference table...")

        diff_df = pd.DataFrame()

        for col in df1.columns:

            if pd.api.types.is_numeric_dtype(df1[col]):

                diff_df[col] = df2[col] - df1[col]

            else:

                diff_df[col] = ""

        # =================================================
        # TXT REPORT
        # =================================================
        log("Generating detailed report...")

        report_lines = []

        for i in range(len(df1)):

            report_lines.append(f"\n========== ROW {i+1} ==========")

            for col in df1.columns:

                v1 = df1.loc[i, col]
                v2 = df2.loc[i, col]

                if pd.isna(v1) and pd.isna(v2):
                    continue

                if v1 != v2:

                    try:

                        diff = v2 - v1
                        perc = (diff / v1) * 100

                        report_lines.append(
                            f"{col}: "
                            f"{v1} --> {v2} | "
                            f"Diff={diff} | "
                            f"{perc:.2f}%"
                        )

                    except:

                        report_lines.append(
                            f"{col}: {v1} --> {v2}"
                        )

        report_text = "\n".join(report_lines)

        # =================================================
        # SAVE TXT IN BOTH FOLDERS
        # =================================================
        log("Saving reports...")

        folder1 = os.path.dirname(file1)
        folder2 = os.path.dirname(file2)

        report1 = os.path.join(
            folder1,
            "comparison_report.txt"
        )

        report2 = os.path.join(
            folder2,
            "comparison_report.txt"
        )

        with open(report1, "w") as f:
            f.write(report_text)

        with open(report2, "w") as f:
            f.write(report_text)

        # =================================================
        # GENERATE comparison.xlsx IN BOTH FOLDERS
        # =================================================
        log("Generating comparison excel files...")

        output_excel1 = os.path.join(
            folder1,
            "comparison.xlsx"
        )

        output_excel2 = os.path.join(
            folder2,
            "comparison.xlsx"
        )

        generate_comparison_excel(
            file1,
            diff_df,
            output_excel1
        )

        generate_comparison_excel(
            file2,
            diff_df,
            output_excel2
        )

        # =================================================
        # CHARTS
        # =================================================
        log("Generating charts...")

        for col in df1.columns:

            if pd.api.types.is_numeric_dtype(df1[col]):

                plt.figure(figsize=(8, 4))

                plt.plot(df1[col], label="File1")
                plt.plot(df2[col], label="File2")

                plt.title(col)

                plt.legend()

                plt.grid(True)

                chart_path = os.path.join(
                    folder1,
                    f"{col}_comparison.png"
                )

                plt.savefig(chart_path)

                plt.close()

        log("SUCCESS!")

        messagebox.showinfo(
            "Completed",
            "comparison.xlsx generated successfully!"
        )

    except Exception as e:

        messagebox.showerror(
            "Error",
            str(e)
        )


# =========================================================
# GUI
# =========================================================
def create_gui():

    root = tk.Tk()

    root.title("SSD Excel Comparator")

    root.geometry("700x400")

    file1_path = tk.StringVar()
    file2_path = tk.StringVar()

    # =====================================================
    # FILE PICKERS
    # =====================================================
    def browse1():

        file = filedialog.askopenfilename(
            filetypes=[("Excel Files", "*.xlsx")]
        )

        file1_path.set(file)

    def browse2():

        file = filedialog.askopenfilename(
            filetypes=[("Excel Files", "*.xlsx")]
        )

        file2_path.set(file)

    # =====================================================
    # LOG FUNCTION
    # =====================================================
    def log(msg):

        log_box.insert(tk.END, msg + "\n")

        log_box.see(tk.END)

    # =====================================================
    # RUN
    # =====================================================
    def run():

        if not file1_path.get() or not file2_path.get():

            messagebox.showwarning(
                "Missing Input",
                "Please select both excel files."
            )

            return

        compare_excels(
            file1_path.get(),
            file2_path.get(),
            log
        )

    # =====================================================
    # UI
    # =====================================================
    tk.Label(root, text="Excel File 1").grid(
        row=0,
        column=0,
        padx=10,
        pady=10
    )

    tk.Entry(
        root,
        textvariable=file1_path,
        width=60
    ).grid(
        row=0,
        column=1
    )

    tk.Button(
        root,
        text="Browse",
        command=browse1
    ).grid(
        row=0,
        column=2
    )

    tk.Label(root, text="Excel File 2").grid(
        row=1,
        column=0,
        padx=10,
        pady=10
    )

    tk.Entry(
        root,
        textvariable=file2_path,
        width=60
    ).grid(
        row=1,
        column=1
    )

    tk.Button(
        root,
        text="Browse",
        command=browse2
    ).grid(
        row=1,
        column=2
    )

    tk.Button(
        root,
        text="Run Comparison",
        command=run,
        bg="green",
        fg="white",
        height=2,
        width=20
    ).grid(
        row=2,
        column=1,
        pady=20
    )

    log_box = tk.Text(
        root,
        height=12,
        width=80
    )

    log_box.grid(
        row=3,
        column=0,
        columnspan=3,
        padx=10,
        pady=10
    )

    root.mainloop()


# =========================================================
# START
# =========================================================
if __name__ == "__main__":
    create_gui()