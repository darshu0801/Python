import tkinter as tk
from tkinter import filedialog, messagebox

import pandas as pd
import os
import shutil

from copy import copy

from openpyxl import load_workbook
from openpyxl.styles import PatternFill


# =========================================================
# COPY STYLE
# =========================================================
def copy_style(src, dst):

    if src.has_style:
        dst._style = copy(src._style)

    dst.font = copy(src.font)
    dst.fill = copy(src.fill)
    dst.border = copy(src.border)
    dst.alignment = copy(src.alignment)
    dst.number_format = copy(src.number_format)
    dst.protection = copy(src.protection)


# =========================================================
# GENERATE comparison.xlsx
# =========================================================
def generate_comparison_excel(
    source_file,
    diff_df,
    output_file
):

    # Copy original workbook
    shutil.copy(source_file, output_file)

    wb = load_workbook(output_file)
    ws = wb.active

    original_max_row = ws.max_row

    # =====================================================
    # START ROW
    # =====================================================
    start_row = original_max_row + 4

    # =====================================================
    # TITLE
    # =====================================================
    title_cell = ws.cell(
        row=start_row,
        column=1
    )

    title_cell.value = "Difference Table (File2 - File1)"

    copy_style(
        ws["A1"],
        title_cell
    )

    # =====================================================
    # COPY MERGED CELLS PROPERLY
    # =====================================================
    original_merged_ranges = list(ws.merged_cells.ranges)

    for merged_range in original_merged_ranges:

        min_col = merged_range.min_col
        max_col = merged_range.max_col

        min_row = merged_range.min_row
        max_row = merged_range.max_row

        # Ignore comparison area
        if max_row < start_row:

            row_offset = start_row + 1

            new_min_row = min_row + row_offset
            new_max_row = max_row + row_offset

            new_range = (
                f"{ws.cell(new_min_row, min_col).coordinate}:"
                f"{ws.cell(new_max_row, max_col).coordinate}"
            )

            try:

                # Create merged range
                ws.merge_cells(new_range)

                # Copy merged value
                old_value = ws.cell(
                    row=min_row,
                    column=min_col
                ).value

                new_cell = ws.cell(
                    row=new_min_row,
                    column=min_col
                )

                new_cell.value = old_value

                copy_style(
                    ws.cell(row=min_row, column=min_col),
                    new_cell
                )

            except:
                pass

    # =====================================================
    # COPY ALL CELLS + FORMATTING
    # =====================================================
    for i in range(1, original_max_row + 1):

        for j in range(1, ws.max_column + 1):

            src_cell = ws.cell(
                row=i,
                column=j
            )

            dst_cell = ws.cell(
                row=i + start_row + 1,
                column=j
            )

            # Skip merged read-only cells
            try:

                if src_cell.coordinate in ws.merged_cells:
                    continue

                dst_cell.value = src_cell.value

                copy_style(
                    src_cell,
                    dst_cell
                )

            except:
                pass

    # =====================================================
    # COLORS
    # =====================================================
    green_fill = PatternFill(
        start_color="C6EFCE",
        end_color="C6EFCE",
        fill_type="solid"
    )

    red_fill = PatternFill(
        start_color="FFC7CE",
        end_color="FFC7CE",
        fill_type="solid"
    )

    perf_keywords = [
        "read",
        "write",
        "mbps",
        "iops",
        "throughput",
        "bw",
        "bandwidth"
    ]

    power_keywords = [
        "power",
        "watt",
        "mw",
        "current"
    ]

    # =====================================================
    # WRITE DIFFERENCE VALUES
    # =====================================================
    for i in range(len(diff_df)):

        excel_row = (
            start_row + 3 + i
        )

        for j in range(len(diff_df.columns)):

            try:

                col_name = diff_df.columns[j]

                cell = ws.cell(
                    row=excel_row,
                    column=j + 1
                )

                value = diff_df.iloc[i, j]

                if pd.isna(value):
                    continue

                # Write only if not merged child
                if cell.coordinate not in ws.merged_cells:

                    cell.value = value

                # =========================================
                # COLOR CODING
                # =========================================
                try:

                    numeric_value = float(value)

                    col_lower = str(col_name).lower()

                    # PERFORMANCE
                    if any(
                        k in col_lower
                        for k in perf_keywords
                    ):

                        if numeric_value > 0:
                            cell.fill = green_fill

                        elif numeric_value < 0:
                            cell.fill = red_fill

                    # POWER
                    elif any(
                        k in col_lower
                        for k in power_keywords
                    ):

                        if numeric_value < 0:
                            cell.fill = green_fill

                        elif numeric_value > 0:
                            cell.fill = red_fill

                except:
                    pass

            except:
                pass

    wb.save(output_file)


# =========================================================
# MAIN COMPARISON
# =========================================================
def compare_excels(
    file1,
    file2,
    log
):

    try:

        log("Loading excel files...")

        df1 = pd.read_excel(file1)
        df2 = pd.read_excel(file2)

        # =================================================
        # VALIDATION
        # =================================================
        if df1.shape != df2.shape:

            raise Exception(
                "Excel shapes are different."
            )

        # =================================================
        # DIFFERENCE TABLE
        # =================================================
        log("Generating difference table...")

        diff_df = pd.DataFrame()

        for col in df1.columns:

            diff_values = []

            for v1, v2 in zip(
                df1[col],
                df2[col]
            ):

                try:

                    n1 = float(v1)
                    n2 = float(v2)

                    diff = n2 - n1

                    diff_values.append(diff)

                except:

                    # KEEP ORIGINAL TEXT
                    diff_values.append(v1)

            diff_df[col] = diff_values

        # =================================================
        # REPORT
        # =================================================
        log("Generating report...")

        report_lines = []

        for i in range(len(df1)):

            report_lines.append(
                f"\n========== ROW {i+1} =========="
            )

            for col in df1.columns:

                v1 = df1.loc[i, col]
                v2 = df2.loc[i, col]

                if pd.isna(v1) and pd.isna(v2):
                    continue

                if str(v1) != str(v2):

                    try:

                        n1 = float(v1)
                        n2 = float(v2)

                        diff = n2 - n1

                        perc = (
                            (diff / n1) * 100
                            if n1 != 0 else 0
                        )

                        report_lines.append(
                            f"{col}: "
                            f"{v1} --> {v2} | "
                            f"Diff={diff} | "
                            f"{perc:.2f}%"
                        )

                    except:

                        report_lines.append(
                            f"{col}: {v1} --> {v2}"
                        )

        report_text = "\n".join(report_lines)

        # =================================================
        # SAVE REPORTS
        # =================================================
        folder1 = os.path.dirname(file1)
        folder2 = os.path.dirname(file2)

        report1 = os.path.join(
            folder1,
            "comparison_report.txt"
        )

        report2 = os.path.join(
            folder2,
            "comparison_report.txt"
        )

        with open(report1, "w") as f:
            f.write(report_text)

        with open(report2, "w") as f:
            f.write(report_text)

        # =================================================
        # GENERATE comparison.xlsx
        # =================================================
        log("Generating comparison.xlsx ...")

        output1 = os.path.join(
            folder1,
            "comparison.xlsx"
        )

        output2 = os.path.join(
            folder2,
            "comparison.xlsx"
        )

        generate_comparison_excel(
            file1,
            diff_df,
            output1
        )

        generate_comparison_excel(
            file2,
            diff_df,
            output2
        )

        log("SUCCESS!")

        messagebox.showinfo(
            "Completed",
            "comparison.xlsx generated successfully!"
        )

    except Exception as e:

        messagebox.showerror(
            "Error",
            str(e)
        )


# =========================================================
# GUI
# =========================================================
def create_gui():

    root = tk.Tk()

    root.title(
        "SSD Excel Comparator"
    )

    root.geometry("850x500")

    file1_path = tk.StringVar()
    file2_path = tk.StringVar()

    # =====================================================
    # BROWSE
    # =====================================================
    def browse1():

        path = filedialog.askopenfilename(
            filetypes=[
                ("Excel Files", "*.xlsx")
            ]
        )

        file1_path.set(path)

    def browse2():

        path = filedialog.askopenfilename(
            filetypes=[
                ("Excel Files", "*.xlsx")
            ]
        )

        file2_path.set(path)

    # =====================================================
    # LOG
    # =====================================================
    def log(msg):

        log_box.insert(
            tk.END,
            msg + "\n"
        )

        log_box.see(tk.END)

    # =====================================================
    # RUN
    # =====================================================
    def run():

        if (
            not file1_path.get()
            or not file2_path.get()
        ):

            messagebox.showwarning(
                "Missing Input",
                "Please select both files."
            )

            return

        compare_excels(
            file1_path.get(),
            file2_path.get(),
            log
        )

    # =====================================================
    # UI
    # =====================================================
    tk.Label(
        root,
        text="Excel File 1"
    ).grid(
        row=0,
        column=0,
        padx=10,
        pady=10
    )

    tk.Entry(
        root,
        textvariable=file1_path,
        width=70
    ).grid(
        row=0,
        column=1
    )

    tk.Button(
        root,
        text="Browse",
        command=browse1
    ).grid(
        row=0,
        column=2,
        padx=10
    )

    tk.Label(
        root,
        text="Excel File 2"
    ).grid(
        row=1,
        column=0,
        padx=10,
        pady=10
    )

    tk.Entry(
        root,
        textvariable=file2_path,
        width=70
    ).grid(
        row=1,
        column=1
    )

    tk.Button(
        root,
        text="Browse",
        command=browse2
    ).grid(
        row=1,
        column=2,
        padx=10
    )

    tk.Button(
        root,
        text="Run Comparison",
        command=run,
        bg="green",
        fg="white",
        width=25,
        height=2
    ).grid(
        row=2,
        column=1,
        pady=20
    )

    log_box = tk.Text(
        root,
        width=100,
        height=18
    )

    log_box.grid(
        row=3,
        column=0,
        columnspan=3,
        padx=10,
        pady=10
    )

    root.mainloop()


# =========================================================
# START
# =========================================================
if __name__ == "__main__":
    create_gui()