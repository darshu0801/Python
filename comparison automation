import tkinter as tk
from tkinter import filedialog, messagebox
import pandas as pd
import os
import shutil
from copy import copy

from openpyxl import load_workbook
from openpyxl.styles import PatternFill

import matplotlib.pyplot as plt


# =========================================================
# COPY STYLE SAFELY
# =========================================================
def copy_style(src, dst):

    if src.has_style:
        dst._style = copy(src._style)

    dst.font = copy(src.font)
    dst.fill = copy(src.fill)
    dst.border = copy(src.border)
    dst.alignment = copy(src.alignment)
    dst.number_format = copy(src.number_format)
    dst.protection = copy(src.protection)


# =========================================================
# GENERATE comparison.xlsx
# =========================================================
def generate_comparison_excel(source_file, diff_df, output_file):

    # Copy original excel
    shutil.copy(source_file, output_file)

    wb = load_workbook(output_file)
    ws = wb.active

    # Add diff table below original
    start_row = ws.max_row + 4

    # =====================================================
    # TITLE
    # =====================================================
    title_cell = ws.cell(row=start_row, column=1)
    title_cell.value = "Difference Table (File2 - File1)"

    copy_style(ws["A1"], title_cell)

    # =====================================================
    # HEADER
    # =====================================================
    header_row = 1

    for col_idx in range(1, len(diff_df.columns) + 1):

        src_cell = ws.cell(row=header_row, column=col_idx)

        dst_cell = ws.cell(
            row=start_row + 1,
            column=col_idx
        )

        dst_cell.value = diff_df.columns[col_idx - 1]

        copy_style(src_cell, dst_cell)

    # =====================================================
    # COLORS
    # =====================================================
    green_fill = PatternFill(
        start_color="C6EFCE",
        end_color="C6EFCE",
        fill_type="solid"
    )

    red_fill = PatternFill(
        start_color="FFC7CE",
        end_color="FFC7CE",
        fill_type="solid"
    )

    perf_keywords = [
        "read",
        "write",
        "mbps",
        "iops",
        "throughput",
        "bw",
        "bandwidth"
    ]

    power_keywords = [
        "power",
        "watt",
        "mw",
        "current"
    ]

    # =====================================================
    # WRITE DATA
    # =====================================================
    for i in range(len(diff_df)):

        src_excel_row = i + 2
        dst_excel_row = start_row + 2 + i

        for j in range(len(diff_df.columns)):

            col_name = diff_df.columns[j]

            src_cell = ws.cell(
                row=src_excel_row,
                column=j + 1
            )

            dst_cell = ws.cell(
                row=dst_excel_row,
                column=j + 1
            )

            value = diff_df.iloc[i, j]

            # Handle NaN
            if pd.isna(value):
                value = ""

            dst_cell.value = value

            copy_style(src_cell, dst_cell)

            # =============================================
            # COLOR CODING
            # =============================================
            if isinstance(value, (int, float)):

                col_lower = str(col_name).lower()

                # PERFORMANCE
                if any(k in col_lower for k in perf_keywords):

                    if value > 0:
                        dst_cell.fill = green_fill

                    elif value < 0:
                        dst_cell.fill = red_fill

                # POWER
                elif any(k in col_lower for k in power_keywords):

                    if value < 0:
                        dst_cell.fill = green_fill

                    elif value > 0:
                        dst_cell.fill = red_fill

    wb.save(output_file)


# =========================================================
# MAIN COMPARISON
# =========================================================
def compare_excels(file1, file2, log):

    try:

        log("Loading excel files...")

        df1 = pd.read_excel(file1)
        df2 = pd.read_excel(file2)

        # =================================================
        # VALIDATION
        # =================================================
        if df1.shape != df2.shape:

            raise Exception(
                "Excel shapes are different."
            )

        # =================================================
        # DIFFERENCE TABLE
        # =================================================
        log("Generating difference table...")

        diff_df = pd.DataFrame()

        for col in df1.columns:

            # Try converting to numeric
            s1 = pd.to_numeric(
                df1[col],
                errors="coerce"
            )

            s2 = pd.to_numeric(
                df2[col],
                errors="coerce"
            )

            # Numeric column
            if s1.notna().sum() > 0:

                diff_df[col] = s2 - s1

            else:

                # Keep text columns blank
                diff_df[col] = ""

        # =================================================
        # REPORT
        # =================================================
        log("Generating report...")

        report_lines = []

        for i in range(len(df1)):

            report_lines.append(
                f"\n========== ROW {i+1} =========="
            )

            for col in df1.columns:

                v1 = df1.loc[i, col]
                v2 = df2.loc[i, col]

                if pd.isna(v1) and pd.isna(v2):
                    continue

                if str(v1) != str(v2):

                    try:

                        n1 = float(v1)
                        n2 = float(v2)

                        diff = n2 - n1

                        perc = (
                            (diff / n1) * 100
                            if n1 != 0 else 0
                        )

                        report_lines.append(
                            f"{col}: "
                            f"{v1} --> {v2} | "
                            f"Diff={diff} | "
                            f"{perc:.2f}%"
                        )

                    except:

                        report_lines.append(
                            f"{col}: {v1} --> {v2}"
                        )

        report_text = "\n".join(report_lines)

        # =================================================
        # SAVE REPORTS
        # =================================================
        folder1 = os.path.dirname(file1)
        folder2 = os.path.dirname(file2)

        report1 = os.path.join(
            folder1,
            "comparison_report.txt"
        )

        report2 = os.path.join(
            folder2,
            "comparison_report.txt"
        )

        with open(report1, "w") as f:
            f.write(report_text)

        with open(report2, "w") as f:
            f.write(report_text)

        # =================================================
        # GENERATE comparison.xlsx
        # =================================================
        log("Generating comparison.xlsx ...")

        output1 = os.path.join(
            folder1,
            "comparison.xlsx"
        )

        output2 = os.path.join(
            folder2,
            "comparison.xlsx"
        )

        generate_comparison_excel(
            file1,
            diff_df,
            output1
        )

        generate_comparison_excel(
            file2,
            diff_df,
            output2
        )

        # =================================================
        # CHARTS
        # =================================================
        log("Generating charts...")

        for col in df1.columns:

            s1 = pd.to_numeric(
                df1[col],
                errors="coerce"
            )

            s2 = pd.to_numeric(
                df2[col],
                errors="coerce"
            )

            if s1.notna().sum() > 0:

                plt.figure(figsize=(8, 4))

                plt.plot(
                    s1,
                    label="File1"
                )

                plt.plot(
                    s2,
                    label="File2"
                )

                plt.title(col)

                plt.legend()

                plt.grid(True)

                chart_path = os.path.join(
                    folder1,
                    f"{col}_comparison.png"
                )

                plt.savefig(chart_path)

                plt.close()

        log("SUCCESS!")

        messagebox.showinfo(
            "Completed",
            "comparison.xlsx generated successfully!"
        )

    except Exception as e:

        messagebox.showerror(
            "Error",
            str(e)
        )


# =========================================================
# GUI
# =========================================================
def create_gui():

    root = tk.Tk()

    root.title("SSD Excel Comparator")

    root.geometry("850x500")

    file1_path = tk.StringVar()
    file2_path = tk.StringVar()

    # =====================================================
    # BROWSE
    # =====================================================
    def browse1():

        path = filedialog.askopenfilename(
            filetypes=[("Excel Files", "*.xlsx")]
        )

        file1_path.set(path)

    def browse2():

        path = filedialog.askopenfilename(
            filetypes=[("Excel Files", "*.xlsx")]
        )

        file2_path.set(path)

    # =====================================================
    # LOG
    # =====================================================
    def log(msg):

        log_box.insert(
            tk.END,
            msg + "\n"
        )

        log_box.see(tk.END)

    # =====================================================
    # RUN
    # =====================================================
    def run():

        if not file1_path.get() or not file2_path.get():

            messagebox.showwarning(
                "Missing Input",
                "Please select both files."
            )

            return

        compare_excels(
            file1_path.get(),
            file2_path.get(),
            log
        )

    # =====================================================
    # UI
    # =====================================================
    tk.Label(
        root,
        text="Excel File 1"
    ).grid(
        row=0,
        column=0,
        padx=10,
        pady=10
    )

    tk.Entry(
        root,
        textvariable=file1_path,
        width=70
    ).grid(
        row=0,
        column=1
    )

    tk.Button(
        root,
        text="Browse",
        command=browse1
    ).grid(
        row=0,
        column=2,
        padx=10
    )

    tk.Label(
        root,
        text="Excel File 2"
    ).grid(
        row=1,
        column=0,
        padx=10,
        pady=10
    )

    tk.Entry(
        root,
        textvariable=file2_path,
        width=70
    ).grid(
        row=1,
        column=1
    )

    tk.Button(
        root,
        text="Browse",
        command=browse2
    ).grid(
        row=1,
        column=2,
        padx=10
    )

    tk.Button(
        root,
        text="Run Comparison",
        command=run,
        bg="green",
        fg="white",
        width=25,
        height=2
    ).grid(
        row=2,
        column=1,
        pady=20
    )

    log_box = tk.Text(
        root,
        width=100,
        height=18
    )

    log_box.grid(
        row=3,
        column=0,
        columnspan=3,
        padx=10,
        pady=10
    )

    root.mainloop()


# =========================================================
# START
# =========================================================
if __name__ == "__main__":
    create_gui()